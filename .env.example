# Required application inputs
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db

# Core runtime settings
APP_TODAY=
APP_HOST=127.0.0.1
APP_PORT=8000
TESSERACT_CMD=

# Provider settings (API key required only when using OpenAI)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible provider endpoint; leave blank for api.openai.com.
OPENAI_BASE_URL=
LLM_TIMEOUT_SECONDS=20

# Custom / optional feature settings
# Retrieval mode: hybrid or bm25.
HYBRID_RETRIEVAL_ENABLED=true
RETRIEVAL_MODE=hybrid
VECTOR_STORE=chroma
VECTOR_DB_PATH=./data/vector_db
# Embedding provider: local_hashing, sentence_transformers, or openai.
EMBEDDING_PROVIDER=local_hashing
EMBEDDING_MODEL=local-hashing-384
# OpenAI embeddings only; falls back to OPENAI_API_KEY.
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=20
BM25_TOP_K=10
VECTOR_TOP_K=10
HYBRID_TOP_K=10
RRF_K=60
# PII detection also supports comma-separated custom terms.
PII_REDACTION_ENABLED=true
PII_REDACTION_MODE=redact
PII_SENSITIVE_TERMS=
PROVENANCE_ENABLED=true
PROVENANCE_VERSION=2
# Optional HMAC key; blank uses a generated key stored in the assistant DB.
PROVENANCE_PSEUDONYM_KEY=
LANGGRAPH_ENABLED=true
