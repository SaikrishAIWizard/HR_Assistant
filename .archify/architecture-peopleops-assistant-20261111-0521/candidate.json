    {
      "dot": "cyan",
      "title": "How to explain it",
      "items": [
        "FastAPI verifies employee identity before dispatching chat.",
        "LangGraph routes; retrieval and leave-tool code execute the work.",
        "Policy answers use authorized evidence; leave writes require confirmation."
      ]
    },
    {
      "dot": "emerald",
      "title": "Trust boundaries",
      "items": [
        "Role, region, and date restrictions apply before evidence reaches the answer step.",
        "PII redaction is enabled by default for external model calls.",
        "The LLM proposes or phrases; application code enforces permissions and writes."
      ]
    }
